# Run scripts/gen-env.sh to create a real .env with random secrets.
POSTGRES_PASSWORD=
JWT_SECRET=            # >= 32 chars
ENCRYPTION_KEY=        # 64 hex chars (AES-256 key that seals the signing keys at rest)
ENCRYPTION_KEY_PREVIOUS=   # only while rotating ENCRYPTION_KEY: the old key(s), comma-separated (see README)
SEED_DEMO_PASSWORD=    # creates the 5 demo users on first start; leave empty in production
BOOTSTRAP_ADMIN_EMAIL=     # first university_admin, created only while the users table is empty
BOOTSTRAP_ADMIN_PASSWORD=  # 12-128 chars; remove this line after the first start
PUBLIC_BASE_URL=http://localhost:3000   # origin embedded in QR codes
# Production stack only (docker-compose.prod.yml):
DOMAIN=                    # public host name, e.g. credentials.example.edu (DNS must point at this host)
WAF_MODE=on                # on = block attacks, DetectionOnly = log only (while tuning false positives)
WAF_PARANOIA=1             # OWASP CRS blocking paranoia level, 1 (fewest false positives) to 4
# Anchor sealed blocks to an external RFC 3161 time-stamping authority (optional; see README):
TSA_URL=                   # e.g. https://freetsa.org/tsr
TSA_CA_FILE=               # e.g. /etc/acvs/tsa/ca.pem (put the TSA's root certificate in deploy/tsa/ca.pem)
# Personal signatures (passkeys / security keys), see README:
REQUIRE_PERSONAL_SIGNATURES=   # true = every approval needs the approver's own security-key signature
REQUIRE_ADMIN_ENROLLMENT=      # true = an admin must also open the window for a person's FIRST security key
REQUIRE_MFA_ROLES=            # e.g. registrar,exam_cell,university_admin: these roles must sign in with an authenticator-app code
WEBAUTHN_RP_ID=               # optional: a parent domain of PUBLIC_BASE_URL's host (default: that host)
# Reverse proxies whose X-Forwarded-For is believed (comma-separated addresses or ranges). Unset = the header is ignored.
# Set it to your proxy's address, never to the whole internet. (The old TRUST_PROXY=true is no longer accepted.)
TRUSTED_PROXIES=
# Request limits (optional; the values shown are the defaults). Counted in Postgres, so they hold across instances and restarts.
RATE_LIMIT_IP_PER_MIN=         # 240  anonymous requests per client address per minute
RATE_LIMIT_USER_PER_MIN=       # 600  signed-in requests per user per minute
LOGIN_IP_PER_MIN=              # 10   login attempts per client address per minute
LOGIN_ACCOUNT_FAILURES=        # 20   failed logins per account (from any address) before it is throttled
LOGIN_ACCOUNT_WINDOW_SECS=     # 900  length of that window
