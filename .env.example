# Run scripts/gen-env.sh to create a real .env with random secrets.
POSTGRES_PASSWORD=
JWT_SECRET=            # >= 32 chars
ENCRYPTION_KEY=        # 64 hex chars (AES-256 key that seals the signing keys at rest)
SEED_DEMO_PASSWORD=    # creates the 5 demo users on first start; leave empty in production
BOOTSTRAP_ADMIN_EMAIL=     # first university_admin, created only while the users table is empty
BOOTSTRAP_ADMIN_PASSWORD=  # 12-128 chars; remove this line after the first start
PUBLIC_BASE_URL=http://localhost:3000   # origin embedded in QR codes
